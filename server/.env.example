# Reference for PRODUCTION deployment (Render, etc.) — these are the actual OS
# environment variable names application.yml reads via ${VAR:default} placeholders,
# set them in your hosting platform's dashboard.
#
# For LOCAL dev, don't use this file — copy server/config/application.properties.example
# to server/config/application.properties instead (Spring Boot loads it natively,
# same variables, dotted-property syntax instead of env-var syntax).

PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/learnify
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Wired in Phase 2 (Auth & Security) — issuer needs the trailing slash, e.g. https://your-tenant.auth0.com/
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# Wired in Phase 3/6 (AI Content Generation, API Key Management)
GEMINI_API_KEY=
API_KEY_ENCRYPTION_SECRET=

# Wired in Phase 7 (External Enrichment — YouTube)
YOUTUBE_API_KEY=

# Wired in Phase 10 (Admin) — comma-separated Auth0 `sub` values allowed to hit /api/v1/admin/**
ADMIN_ALLOWED_SUBS=

# Comma-separated frontend origin(s) allowed to call this API. Defaults to the local
# Vite dev server; add your deployed Vercel URL here once that exists too, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=
